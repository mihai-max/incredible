# Server-side only. Never prefix these with NEXT_PUBLIC_ — that prefix inlines
# the value into the browser bundle, which would publish your Resend key.
#
# Set these in your host's dashboard (Vercel/Netlify/Cloudflare project settings),
# not in a committed file. .env.local is gitignored for local development.

RESEND_API_KEY=re_your_key_here

# Must be on a domain verified in Resend. Use onboarding@resend.dev until
# incredible.website is verified at https://resend.com/domains
MAIL_FROM=enquiries@incredible.website

# Where enquiries land.
MAIL_TO=hello@incredible.website

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). This one IS public — it ends
# up in the page either way. Leave it empty to ship with no analytics and no
# cookie banner. Read at build time, so rebuild after changing it.
NEXT_PUBLIC_GA_ID=
